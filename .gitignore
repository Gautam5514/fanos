# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo: this ignore covers both frontend/ and backend/ (patterns are NOT root-anchored).

# --- dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- testing / coverage ---
coverage/

# --- next.js / build output ---
.next/
out/
build/
dist/

# --- env files (secrets) — never push. Keep only the example. ---
.env
.env.*
!.env.example

# --- logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- typescript ---
*.tsbuildinfo
next-env.d.ts

# --- misc / os ---
.DS_Store
Thumbs.db
*.pem
*.key

# --- editors ---
.vscode/
.idea/
*.swp

# --- deploy ---
.vercel

# --- app-specific: creator feedback (contains personal data) ---
frontend/data/
