# Copy to .env (git-ignored) and fill in.

# Port the API listens on (most hosts set this automatically)
PORT=4000

# --- Supabase (required for accounts + live data) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Bypasses Row Level Security. Never commit, never put it in the frontend.
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase personal/CLI access token (starts with sbp_). Used by the Supabase CLI only.
# Get it from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# --- AI (Groq) -----------------------------------------------------------------------
# Get a key at https://console.groq.com/keys . Without it the app keeps working with its built-in engine.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile        # smart model: copilot, replies, posts
# GROQ_FAST_MODEL=llama-3.1-8b-instant      # instant tasks: idea summaries
# GROQ_STRUCTURED_MODEL=openai/gpt-oss-20b  # strict JSON: Idea Coach, weekly summary
# Any other OpenAI-compatible provider still works as a fallback (used only when GROQ_API_KEY is empty):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: YouTube Data API v3 key — lets creators auto-fill their real subscriber count
# from their channel handle on the setup page. Free, from https://console.cloud.google.com/
# (enable "YouTube Data API v3", then create an API key). No OAuth needed for public stats.
# YOUTUBE_API_KEY=

# Admin token to read ALL creator-test feedback via GET /api/feedback (header: x-admin-token)
# FEEDBACK_ADMIN_TOKEN=

# --- Google sign-in (Firebase Admin) -------------------------------------------------
# Service-account key from Firebase console → Project settings → Service accounts → Generate new key.
# SECRET: never commit it. Put the WHOLE json on one line, in single quotes (works on Render too):
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}'
# If your host mangles that value, use base64 instead:   base64 -i key.json | tr -d '\n'
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Local development only: point at the downloaded file
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json

# --- AI (Groq) -----------------------------------------------------------------------
# Get a key at https://console.groq.com/keys . Without it the app keeps working with its built-in engine.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile        # smart model: copilot, replies, posts
# GROQ_FAST_MODEL=llama-3.1-8b-instant      # instant tasks: idea summaries
# GROQ_STRUCTURED_MODEL=openai/gpt-oss-20b  # strict JSON: Idea Coach, weekly summary
# Any other OpenAI-compatible provider still works as a fallback (used only when GROQ_API_KEY is empty):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: YouTube Data API v3 key — lets creators auto-fill their real subscriber count
# from their channel handle on the setup page. Free, from https://console.cloud.google.com/
# (enable "YouTube Data API v3", then create an API key). No OAuth needed for public stats.
# YOUTUBE_API_KEY=

# Admin token to read ALL creator-test feedback via GET /api/feedback (header: x-admin-token)
# FEEDBACK_ADMIN_TOKEN=

# --- Google sign-in (Firebase Admin) -------------------------------------------------
# Service-account key from Firebase console → Project settings → Service accounts.
# SECRET: keep it out of git. Use ONE of these:
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
