# Copy to .env.local (git-ignored) and fill in.
# The frontend holds NO secrets — all keys live in backend/.env.

# URL of the backend API service (no trailing slash). /api/* is proxied there.
# Read at build time on most hosts, so redeploy after changing it.
BACKEND_URL=http://localhost:4000

# --- Google sign-in (Firebase web app config; these are public identifiers, not secrets) ---
# Firebase console → Project settings → General → Your apps → Web app → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
