# Copy to .env.local (git-ignored) and fill in.

# --- Supabase (required for accounts + live data) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase personal/CLI access token (starts with sbp_). Used by the Supabase CLI only.
# Get it from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# Public URL of the app
APP_URL=http://localhost:3000

# Lets additional people register as creator after the first creator account exists.
# CREATOR_ACCESS_CODE=change-me-to-a-long-random-string

# Optional LLM (OpenAI or any OpenAI-compatible API, e.g. Gemini's OpenAI endpoint)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Admin token to read ALL creator-test feedback via GET /api/feedback (header: x-admin-token)
# FEEDBACK_ADMIN_TOKEN=
