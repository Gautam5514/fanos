# Copy to .env.local (git-ignored) and fill in.
# The frontend holds NO secrets — all keys live in backend/.env.

# URL of the backend API service (no trailing slash). /api/* is proxied there.
# Read at build time on most hosts, so redeploy after changing it.
BACKEND_URL=http://localhost:4000

# --- Google sign-in: NOTHING to set here ----------------------------------------------
# The backend reads your Firebase web settings from its service account and sends them to the page,
# so the frontend host (Vercel) only needs BACKEND_URL above.
# Optional: you may still pin the (public, non-secret) web settings at build time. They are only a fallback.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
